<Window x:Class="WpfSensorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arduino Sensor &amp; Water Level Monitor" Height="450" Width="850"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Kết nối Serial (COM Port)" Grid.Row="0" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cổng COM:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboComPorts" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                <Button x:Name="btnRefresh" Content="🔄" Grid.Column="2" Width="30" Height="28" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                <Button x:Name="btnConnect" Content="Connect" Grid.Column="3" Width="85" Height="28" Margin="0,0,5,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="btnConnect_Click"/>
                <Button x:Name="btnDisconnect" Content="Disconnect" Grid.Column="4" Width="85" Height="28" Background="#FFE53935" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="btnDisconnect_Click"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFE1F5FE" BorderBrush="#FF81D4FA" BorderThickness="1" CornerRadius="8" Margin="0,0,0,5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌡️ NHIỆT ĐỘ" FontSize="12" FontWeight="Bold" Foreground="#FF0288D1"/>
                        <TextBlock x:Name="txtTemperature" Text="--.-- °C" FontSize="26" FontWeight="Bold" Foreground="#FF01579B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#FFE8F5E9" BorderBrush="#FFA5D6A7" BorderThickness="1" CornerRadius="8" Margin="0,5,0,5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💧 ĐỘ ẨM" FontSize="12" FontWeight="Bold" Foreground="#FF388E3C"/>
                        <TextBlock x:Name="txtHumidity" Text="--.-- %" FontSize="26" FontWeight="Bold" Foreground="#FF1B5E20" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#FFFDE0DC" BorderBrush="#FFEF9A9A" BorderThickness="1" CornerRadius="8" Margin="0,5,0,0" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌊 MỰC NƯỚC THỰC TẾ" FontSize="12" FontWeight="Bold" Foreground="#FFC62828"/>
                        <TextBlock x:Name="txtWaterLevel" Text="--.-- cm" FontSize="26" FontWeight="Bold" Foreground="#FFB71C1C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="#FFF3E5F5" BorderBrush="#FFCE93D8" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="📷 CAMERA GIÁM SÁT MỰC NƯỚC" FontSize="13" FontWeight="Bold" Foreground="#FF7B1FA2" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    
                    <Border Grid.Row="1" Background="Black" CornerRadius="5" ClipToBounds="True">
                        <Image x:Name="imgWebcam" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="btnToggleGrayscale" Content="Khử màu (Trắng/Đen)" Grid.Row="2" Height="28" Margin="0,6,0,0" 
                            Background="#FF7E57C2" Foreground="White" FontWeight="Bold" Click="btnToggleGrayscale_Click"/>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,10,0,0" Background="#FFF5F5F5">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Trạng thái: Sẵn sàng kết nối" Foreground="Gray" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>