<Window x:Class="WpfSensorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="mainWindow"
        Title="Arduino Sensor &amp; Water Level Monitor" Height="520" Width="940"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Background="#FFFFFF">

    <Window.Resources>
        <!-- Style Thanh Gạt (Toggle Switch) Kiểu Điện Thoại Mobile -->
        <Style x:Key="PhoneToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="42" Height="22">
                                <Border x:Name="SwitchTrack" CornerRadius="11" Background="#B0BEC5"/>
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#FF4CAF50"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KẾT NỐI SERIAL & THANH GẠT DARK MODE -->
        <GroupBox x:Name="grpSerial" Header="Kết nối Serial (COM Port)" Grid.Row="0" Margin="0,0,0,15" Padding="10" Foreground="#333333">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblComPort" Text="Cổng COM:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#333333"/>
                <ComboBox x:Name="cboComPorts" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btnRefresh" Content="🔄" Grid.Column="2" Width="30" Height="28" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                <Button x:Name="btnConnect" Content="Connect" Grid.Column="3" Width="85" Height="28" Margin="0,0,5,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="btnConnect_Click"/>
                <Button x:Name="btnDisconnect" Content="Disconnect" Grid.Column="4" Width="85" Height="28" Margin="0,0,20,0" Background="#FFE53935" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="btnDisconnect_Click"/>

                <!-- THANH GẠT CHUYỂN GIAO DIỆN SÁNG / TỐI -->
                <CheckBox x:Name="toggleDarkMode" Grid.Column="5" Style="{StaticResource PhoneToggleSwitchStyle}" VerticalAlignment="Center" Click="toggleDarkMode_Click">
                    <TextBlock x:Name="lblDarkMode" Text="🌙 Dark Mode" FontWeight="Bold" FontSize="12" Foreground="#333333"/>
                </CheckBox>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- THẺ THÔNG SỐ CẢM BIẾN -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Nhiệt độ -->
                <Border x:Name="cardTemp" Grid.Row="0" Background="#FFE8F5E9" BorderBrush="#FFA5D6A7" BorderThickness="1" CornerRadius="8" Margin="0,0,0,5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="lblTempHeader" Text="🌡️ NHIỆT ĐỘ" FontSize="12" FontWeight="Bold" Foreground="#FF388E3C"/>
                        <TextBlock x:Name="txtTemperature" Text="{Binding Temperature}" FontSize="26" FontWeight="Bold" Foreground="#FF1B5E20" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Độ ẩm -->
                <Border x:Name="cardHum" Grid.Row="1" Background="#FFE8F5E9" BorderBrush="#FFA5D6A7" BorderThickness="1" CornerRadius="8" Margin="0,5,0,5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="lblHumHeader" Text="💧 ĐỘ ẨM" FontSize="12" FontWeight="Bold" Foreground="#FF388E3C"/>
                        <TextBlock x:Name="txtHumidity" Text="{Binding Humidity}" FontSize="26" FontWeight="Bold" Foreground="#FF1B5E20" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Mực nước thực tế (Tự động đổi màu) -->
                <Border x:Name="cardWater" Grid.Row="2" Background="{Binding WaterLevelBgColor}" BorderBrush="{Binding WaterLevelColor}" BorderThickness="1.5" CornerRadius="8" Margin="0,5,0,0" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="lblWaterHeader" Text="🌊 MỰC NƯỚC THỰC TẾ" FontSize="12" FontWeight="Bold" Foreground="{Binding WaterLevelColor}"/>
                        <TextBlock x:Name="txtWaterLevel" Text="{Binding WaterLevel}" FontSize="26" FontWeight="Bold" Foreground="{Binding WaterLevelColor}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CÂY ĐO ĐỘ NGUY HIỂM ĐỘNG -->
            <Border x:Name="cardDanger" Grid.Column="1" Margin="0,0,10,0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10" Width="85">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚠️ NGUY HIỂM" FontSize="10" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <!-- Khung chứa thanh màu -->
                        <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True" BorderBrush="#BDBDBD" BorderThickness="1" Background="#FAFAFA">
                            <Grid x:Name="gridBarContainer">
                                <Grid VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="4*"/>
                                        <RowDefinition Height="4*"/>
                                    </Grid.RowDefinitions>

                                    <Rectangle Grid.Row="0" Fill="#E53935" ToolTip="Mức 8 - 10: Nguy hiểm cao"/>
                                    <Rectangle Grid.Row="1" Fill="#FFF176" ToolTip="Mức 4 - 8: Cảnh báo"/>
                                    <Rectangle Grid.Row="2" Fill="#29B6F6" ToolTip="Mức 0 - 4: An toàn"/>
                                </Grid>

                                <!-- Layer màn che -->
                                <Rectangle x:Name="rectUnfilledOverlay" Fill="#FAFAFA" VerticalAlignment="Top" Height="0"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="4*"/>
                                <RowDefinition Height="4*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="10" FontSize="10" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Top" Margin="0,-5,0,0"/>
                            <TextBlock Grid.Row="0" Text="- 8" FontSize="10" FontWeight="Bold" Foreground="#F57F17" VerticalAlignment="Bottom" Margin="0,0,0,-5"/>
                            <TextBlock Grid.Row="1" Text="- 4" FontSize="10" FontWeight="Bold" Foreground="#0288D1" VerticalAlignment="Bottom" Margin="0,0,0,-5"/>
                            <TextBlock Grid.Row="2" Text="- 0" FontSize="10" FontWeight="Bold" Foreground="#616161" VerticalAlignment="Bottom" Margin="0,0,0,-5"/>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="txtDangerLevel" Grid.Row="2" Text="{Binding DangerLevel}" FontSize="12" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- CAMERA & NÚT ĐIỀU KHIỂN -->
            <Border x:Name="cardCamera" Grid.Column="2" Background="#FFF3E5F5" BorderBrush="#FFCE93D8" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="lblCamTitle" Text="📷 CAMERA GIÁM SÁT MỰC NƯỚC" FontSize="13" FontWeight="Bold" Foreground="#FF7B1FA2" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    
                    <Border Grid.Row="1" Background="Black" CornerRadius="5" ClipToBounds="True">
                        <Image x:Name="imgWebcam" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button x:Name="btnScreenshot" Content="📸" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,0,4"
                                Background="#FF4CAF50" Foreground="White" FontSize="14" FontWeight="Bold" ToolTip="Chụp Màn Hình Camera" Click="btnScreenshot_Click"/>
                        
                        <Button x:Name="btnToggleGrayscale" Content="Gray" Height="26" Margin="0,0,0,4" 
                                Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="btnToggleGrayscale_Click"/>
                        
                        <Button x:Name="btnToggleBackground" Content="Background" Height="26" Margin="0,0,0,4" 
                                Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="btnToggleBackground_Click"/>

                        <Button x:Name="btnToggleOverlay" Content="Hiển thị Vạch Mực Nước" Height="26"
                                Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="btnToggleOverlay_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- THANH TRẠNG THÁI -->
        <StatusBar x:Name="sbStatus" Grid.Row="2" Margin="0,10,0,0" Background="#FFF5F5F5">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>